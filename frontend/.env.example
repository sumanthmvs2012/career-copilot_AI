# Base URL of the Spring Boot backend. Copy to .env and adjust per environment.
VITE_API_BASE_URL=http://localhost:8080

# Dev-only dummy login until the backend exists (demo@example.com / password123).
# Ignored in production builds. Set to false or remove once /auth/login is live.
VITE_USE_MOCK_AUTH=true

# Dev-only in-memory /profile until the backend endpoint is wired up. Ignored in production builds.
# Needs a token (log in with the mock auth above). Set to false or remove once /profile is live.
VITE_USE_MOCK_PROFILE=true

# Dev-only in-memory /resumes until the backend endpoint is wired up. Ignored in production builds.
# Needs a token and keeps only file metadata. Set to false or remove once /resumes is live.
VITE_USE_MOCK_RESUMES=true

# Dev-only in-memory /jobs/match and /jobs until the backend endpoints are wired up. Ignored in
# production builds. Needs a token; keeps pasted jobs in memory only. Set to false or remove once live.
VITE_USE_MOCK_JOBS=true

# Dev-only sample applications on the dashboard (shows a "Demo data" badge). Ignored in production
# builds. Keep false or remove once the applications API is live.
# VITE_USE_MOCK_APPLICATIONS=false

# Dev-only in-memory interview questions and Gmail mailbox/reminders until the backend endpoints are
# wired up. Ignored in production builds. Keep false or remove once the APIs are live.
# VITE_USE_MOCK_INTERVIEW=false
# VITE_USE_MOCK_MAIL=false

# Dev-only fake "Find new matches" result for the draft agent. Ignored in production builds.
# VITE_USE_MOCK_AGENT=false
