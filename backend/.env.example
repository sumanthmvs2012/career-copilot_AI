# Copy to backend/.env for local development. Never commit .env.
# The same file is read by Spring Boot and by compose.yaml (local Postgres).

DB_URL=jdbc:postgresql://localhost:5432/career_copilot
DB_USERNAME=copilot
DB_PASSWORD=change-me-local-only

# At least 32 random bytes. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes

# Optional overrides
# JWT_EXPIRY=PT1H
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# AUTH_RATE_LIMIT_MAX=10
# AUTH_RATE_LIMIT_WINDOW=PT1M
# RESUME_STORAGE_DIR=./storage

# Job scraper (off by default). Reads public Greenhouse and Lever board APIs once per board per run.
# SCRAPER_ENABLED=true
# SCRAPER_BOARDS=greenhouse:stripe,lever:palantir
# SCRAPER_CRON=0 0 * * * *

# Mailbox tracking (Gmail, read-only). All optional: without them the app runs and reports "not configured".
# Create an OAuth client in Google Cloud and add this redirect URI to it.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8080/mail-connections/callback
# base64 of 32 random bytes. Generate one with: openssl rand -base64 32
# MAIL_TOKEN_KEY=
# FRONTEND_URL=http://localhost:5173
# MAIL_SYNC_ENABLED=false
# REMINDER_DAYS=7
# REMINDERS_ENABLED=true
